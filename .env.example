# Copy to .env (or export these directly) and fill in real values.
# Never commit a filled-in .env file.
#
# You only need to fill in ONE of the two sections below (TVM or Security
# Center) -- kev-pulse auto-detects which backend has real credentials and
# uses it as primary. Fill in both if you want this server to work against
# both at once (see backend.secondary in config.yaml / config.example.yaml).

# Tenable Vulnerability Management (used by backend.type = tvm, and always
# by the plugin feed watcher itself -- see config.example.yaml's comment on
# _tvm_like)
TIO_ACCESS_KEY=
TIO_SECRET_KEY=

# Tenable Security Center
TSC_URL=
TSC_USERNAME=
TSC_PASSWORD=

# Optional: only needed if you fill in BOTH sections above and want to
# choose which one the autonomous polling loop targets. Leave unset to
# auto-detect (or to keep the default of "tvm" when both are configured).
# KEVPULSE_BACKEND_TYPE=tvm
