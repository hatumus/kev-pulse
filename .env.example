# Copy to .env (or export these directly) and fill in real values.
# Never commit a filled-in .env file.

# Tenable Vulnerability Management (used if backend.type = tvm, and by the plugin feed watcher)
TIO_ACCESS_KEY=
TIO_SECRET_KEY=

# Tenable Security Center (used if backend.type = sc)
TSC_USERNAME=
TSC_PASSWORD=
